# Azure DevOps Personal Access Token
# Required for cloning the DBT repository from Azure DevOps
# Add this as a GitHub Codespaces secret named: AZURE_DEVOPS_PAT
AZURE_DEVOPS_PAT=your_personal_access_token_here

# DBT Database Connection (optional - can also configure in ~/.dbt/profiles.yml)
# Add these as GitHub Codespaces secrets or configure locally after container starts
DBT_REDSHIFT_HOST=your-cluster.region.redshift.amazonaws.com
DBT_REDSHIFT_USER=your_database_user
DBT_REDSHIFT_PASSWORD=your_database_password
DBT_REDSHIFT_DATABASE=your_database_name
DBT_REDSHIFT_SCHEMA=your_target_schema
DBT_REDSHIFT_PORT=5439
