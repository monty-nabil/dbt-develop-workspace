# Azure DevOps Personal Access Token
# Required for cloning the DBT repository from Azure DevOps
# Add this as a GitHub Codespaces secret named: AZURE_DEVOPS_PAT
AZURE_DEVOPS_PAT=your_personal_access_token_here

# DBT Target Environment (dev or prod)
DBT_TARGET=dev

# DBT Database Connection - DEV Environment
DBT_DEV_REDSHIFT_HOST=dev-cluster.region.redshift.amazonaws.com
DBT_DEV_REDSHIFT_USER=dev_database_user
DBT_DEV_REDSHIFT_PASSWORD=dev_database_password
DBT_DEV_REDSHIFT_DATABASE=dev_database_name
DBT_DEV_REDSHIFT_SCHEMA=dev_schema
DBT_DEV_REDSHIFT_PORT=5439

# DBT Database Connection - PROD Environment
DBT_PROD_REDSHIFT_HOST=prod-cluster.region.redshift.amazonaws.com
DBT_PROD_REDSHIFT_USER=prod_database_user
DBT_PROD_REDSHIFT_PASSWORD=prod_database_password
DBT_PROD_REDSHIFT_DATABASE=prod_database_name
DBT_PROD_REDSHIFT_SCHEMA=prod_schema
DBT_PROD_REDSHIFT_PORT=5439
